# LLM Provider: "ollama" (local, gratuit) ou "claude" (cloud, payant)
LLM_PROVIDER=claude

# Ollama config (seulement si LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Claude config (seulement si LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-VOTRE-CLE-ICI

# Demo mode: utilise dashboard-demo.db au lieu de dashboard.db
# DEMO_MODE=true

# Brandfetch Logo API (gratuit — https://developers.brandfetch.com/register)
BRANDFETCH_CLIENT_ID=

# Server
PORT=3001

# JWT authentication — enables login page with user/password.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable auth (development mode).
# JWT_SECRET=

# Data directory (dossier surveillé pour les fichiers Excel)
DATA_DIR=../data
